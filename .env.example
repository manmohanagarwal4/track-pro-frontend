# TrackPro build-time configuration (Phase 1: none of these are required).
# Values are passed with --dart-define, e.g.
#   flutter run --dart-define=MAP_PROVIDER=simulated
#
# Base map provider. "simulated" = offline Delhi NCR vector map (default, no key, no network).
MAP_PROVIDER=simulated

# API key for a future real map provider (Mapbox / Google / etc.). Leave empty for the simulated map.
# Never commit a real key.
MAP_API_KEY=
